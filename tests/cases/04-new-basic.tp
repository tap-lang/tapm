// new 的正常路径：建出骨架，三个文件都在，manifest 里写着包名。
import lib;
import std.vec as vec;
import std.env as env;

fn main(): i32 {
    let c: Case = lib.case();
    let args: Vec<String> = vec.new<String>();
    args = args.push("new");
    args = args.push("demo");
    c = lib.run(c, env.var("TAPM"), args, ".");
    c = lib.expect_exit(c, 0);
    c = lib.expect_contains(c, c.stdout, "已创建项目 demo");

    c = lib.expect_dir(c, "demo");
    c = lib.expect_file(c, "demo/package.toml");
    c = lib.expect_file(c, "demo/src/main.tp");
    c = lib.expect_file(c, "demo/README.md");

    c = lib.expect_contains(c, lib.read(c, "demo/package.toml"), "demo");
    c = lib.expect_contains(c, lib.read(c, "demo/src/main.tp"), "fn main");
    return lib.finish(c);
}
