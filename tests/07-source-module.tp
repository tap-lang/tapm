// tapm test 应把包的 src/ 加入 TAP_MODULE_PATH，用例无需软链接即可导入源码模块。
import test.lib;
import test.lib.Case;
import package as pkg;

fn main(): i32 {
    let c: Case = lib.case();
    let joined: String = pkg.join_path("alpha", "beta");
    c = lib.expect_contains(c, joined, "alpha/beta");
    return lib.finish(c);
}
