// path 依赖安装时应显示依赖名、链接目标和完成状态。
import lib;
import std.env as env;
import std.fs as fs;
import std.vec as vec;

fn main(): i32 {
    let c: Case = lib.case();
    fs.make_dir("local");
    fs.make_dir("local/src");
    let written: i64 = fs.write_text("local/package.toml",
        "[package]\nname = \"local\"\nversion = \"1.0.0\"\nentry = \"src/lib.tp\"\n");
    written = fs.write_text("local/src/lib.tp", "pub fn value(): i32 { return 42; }\n");
    written = fs.write_text("package.toml",
        "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nentry = \"src/main.tp\"\n\n" +
        "[dependencies]\nlocal = { path = \"local\" }\n");

    let args: Vec<String> = vec.new<String>();
    args = args.push("install");
    c = lib.run(c, env.var("TAPM"), args, ".");
    c = lib.expect_exit(c, 0);
    c = lib.expect_contains(c, c.stdout, "安装 path 依赖 local: link ../local");
    c = lib.expect_contains(c, c.stdout, "已安装 path 依赖 local");
    c = lib.expect_dir(c, "packages/local");
    c = lib.expect_contains(c, lib.read(c, "package.lock.toml"),
        "source = \"path+../local\"");
    return lib.finish(c);
}
