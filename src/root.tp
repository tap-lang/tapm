// 包根查找：从当前目录向上找含 package.toml 的那一层。
//
// 和 cargo 一样：`cd src && tapm test` 也能找到包根，不用非得在最外层。

import std.fs as fs;
import std.string_builder as sb;
import std.string_builder.StringBuilder;

extern fn getcwd(buffer: *u8, size: u64): *u8;

// 真实的当前工作目录。
//
// **不能用 PWD**：那是 shell 维护的环境变量，chdir() 之后不会更新。tapm test 用
// process 的 current_dir 把用例进程切到临时目录，子进程里的 PWD 却还是父进程的
// 路径 —— 用它找包根会找到错的地方（实测：用例的 package.toml 写进了临时目录，
// 但 tapm list 却按 PWD 去读了 tapm 自己的包根，列出了一堆不相干的依赖）。
pub fn current_dir(): String {
    let buffer: [u8; 4096] = [0; 4096];
    let result: *u8 = getcwd(&buffer[0], 4096);
    if (result == null) {
        return "";
    }
    let builder: StringBuilder = sb.new();
    let index: uint = 0;
    while (index < 4096) {
        let ch: u8 = buffer[index];
        if (ch == 0) {
            break;
        }
        builder.append_byte(ch);
        index = index + 1;
    }
    let text: String = builder.to_string();
    builder.free();
    return text;
}

// 从当前目录向上找含 package.toml 的目录。找不到返回空串。
pub fn find(): String {
    let current: String = current_dir();
    if (current.len() == 0) {
        return "";
    }
    while (true) {
        if (fs.exists(current + "/package.toml")) {
            return current;
        }
        if (current == "/") {
            return "";
        }
        let parent: String = parent_of(current);
        if (parent == current || parent.len() == 0) {
            return "";
        }
        current = parent;
    }
    // 编译器不做流分析，`while (true)` 后面还是要有个 return 才肯过。
    return "";
}

// 本机路径分隔符。POSIX 只有 '/'，但 Windows 的 getcwd 给的是 `\` ——
// 只认 '/' 的话，在子目录里跑 `tapm test` 会在这里返回空串，然后报
// 「从当前目录向上找不到 package.toml」（包根下能跑，所以不容易发现）。
fn is_separator(ch: u8): bool {
    return ch == 47 || ch == 92;   // '/' 或 '\'
}

// 去掉路径最后一段。`/a/b` → `/a`，`/a` → `/`，`a` → `""`，`E:/a` → `E:/`。
// 盘符根（`E:/`）没有上一级，返回 `""` —— 这也是 find 的终止条件之一。
fn parent_of(path: String): String {
    let index: uint = path.len();
    while (index > 0) {
        if (is_separator(path.byte_at(index - 1))) {
            if (index == 1) {
                return path.slice(0, 1);
            }
            let parent: String = path.slice(0, index - 1);
            // "E:/" 去掉分隔符只剩 "E:"，那已经是「当前盘的工作目录」这种相对语义，
            // 拼上 "/package.toml" 会变成 "E:package.toml"。
            if (parent.len() == 2 && parent.byte_at(1) == 58) {   // ':'
                return "";
            }
            return parent;
        }
        index = index - 1;
    }
    return "";
}
