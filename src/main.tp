// tapm：tap 的依赖管理。
//
//   tapm new <名字>    按模板生成一个新项目的骨架
//   tapm install       读 package.toml，把依赖接进 packages/
//   tapm list          列出 packages/ 里已经接上的依赖
//   tapm help          显示用法
//
// tapm 自己也是一个 tap 包（package.toml + src/），所以在目标项目的包根目录下这样跑：
//
//   tap run <tapm 仓库路径>/src/main.tp -- install
//
// 或者先 cd 到 tapm 自己的目录，用包模式（不带文件参数）：
//
//   tap run -- install
//
// 发布时用 `tap build` 编译成二进制，装到 PATH 里就能直接 `tapm install`。
import std.env as env;
import std.fs as fs;
import std.vec as vec;
import new;
import install;
import test;
import root;
import package;

fn print_usage() {
    print("用法: tapm <命令>\n");
    print("  install / list / test 从当前目录向上找 package.toml 来确定包根，\n");
    print("  所以在包根或它的任意子目录下都能跑。\n");
    print("命令:\n");
    print("  new <名字>         按模板生成一个新项目的骨架\n");
    print("  install            读 package.toml，把依赖接进 packages/\n");
    print("  list               列出 packages/ 里已经接上的依赖\n");
    print("  test               跑 tests 下的用例\n");
    print("  --help,-h          显示这条信息\n");
    print("  --version,-V       显示版本信息\n");
}

fn print_version() {
    print("tapm version 0.1.0\n");
}

fn run_new(name: String): i32 {
    let result: Result<i32, String> = new.new(".", name);
    if (is_err(result)) {
        let message: String = match (result) {
            Result.Ok(value) => "",
            Result.Err(reason) => reason,
        };
        print("tapm: %s\n", message);
        return 1;
    }
    print("已创建项目 %s\n", name);
    return 0;
}

// main 不能返回 Result，也不能用 `?`，所以错误都在辅助函数里收口。
fn run_install(root: String): i32 {
    let result: Result<i32, String> = install.install(root);
    if (is_err(result)) {
        let message: String = match (result) {
            Result.Ok(value) => "",
            Result.Err(reason) => reason,
        };
        print("tapm: %s\n", message);
        return 1;
    }
    print("已安装依赖\n");
    return 0;
}

fn run_list(root: String): i32 {
    let result: Result<Vec<String>, String> = install.list(root);
    if (is_err(result)) {
        let message: String = match (result) {
            Result.Ok(value) => "",
            Result.Err(reason) => reason,
        };
        print("tapm: %s\n", message);
        return 1;
    }

    // unwrap_or 在「泛型结构体」上推不出类型参数，用 match。
    let names: Vec<String> = match (result) {
        Result.Ok(inner) => inner,
        Result.Err(reason) => vec.new<String>(),
    };
    print("%u 个依赖\n", names.len());
    let index: uint = 0;
    while (index < names.len()) {
        print("  %s\n", names.get(index));
        index = index + 1;
    }
    vec.free(names);
    return 0;
}

fn main(): i32 {
    let arguments: Vec<String> = env.args();
    if (arguments.len() < 2) {
        print_usage();
        vec.free(arguments);
        return 1;
    }

    let command: String = arguments.get(1);
    let status: i32 = 0;

    // install / list / test 都要包根：从当前目录向上找 package.toml。
    // new 不需要 —— 它在当前目录建新项目。
    let package_root: String = "";
    if (command == "install" || command == "list" || command == "test") {
        package_root = root.find();
        if (package_root.len() == 0) {
            print("tapm: 从当前目录向上找不到 package.toml\n");
            print("  请在 tap 包目录（含 package.toml 的那一层）或其子目录下运行\n");
            vec.free(arguments);
            return 2;
        }
    }

    if (command == "new") {
        if (arguments.len() < 3) {
            print("tapm: new 需要一个项目名\n");
            print_usage();
            status = 1;
        } else {
            status = run_new(arguments.get(2));
        }
    } else if (command == "install") {
        status = run_install(package_root);
    } else if (command == "list") {
        status = run_list(package_root);
    } else if (command == "test") {
        status = test.run(package_root);
    } else if (command == "help" || command == "--help" || command == "-h") {
        print_usage();
    } else if (command == "--version" || command == "-V") {
        print_version();
    } else {
        print("tapm: 未知命令 '%s'\n", command);
        print_usage();
        status = 1;
    }

    vec.free(arguments);
    return status;
}
