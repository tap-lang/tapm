// 包清单（package.toml）和锁文件（package.lock.toml）的读写。
//
// 布局约定见 docs/package.md：
//     myapp/
//     ├─ package.toml
//     ├─ src/
//     └─ packages/        <- tapm install 把依赖接到这里
import std.fs;
import std.string_builder as sb;
import std.string_builder.StringBuilder;
import std.vec;
import std.vec.Vec;
import toml;
import toml.Toml;

// 拼接路径。tap 没有字符串 `+`，这里集中做。
pub fn join_path(left: String, right: String): String {
    let builder: StringBuilder = sb.new();
    builder.append(left);
    builder.append("/");
    builder.append(right);
    let text: String = builder.to_string();
    builder.free();
    return text;
}

// 一个依赖。path 和 git 二选一；Git 依赖可用 rev 固定到 commit、tag 或 branch。
pub struct Dependency {
    name: String,
    path: String,
    git: String,
    rev: String,
}

// 一个模块别名：`[modules]` 段的一条 `name = "path"`。
//
// name 是模块名的第一段，path 相对包根（也可以写绝对路径）。tapm 把它翻成
// TAP_MODULE_PATH 的 `name=path` 条目交给编译器 —— 编译器不解析 TOML。
pub struct ModuleAlias {
    name: String,
    path: String,
}

// 一个包的清单。
pub struct Manifest {
    root: String,             // 包根目录（绝对或相对于当前目录）
    name: String,
    version: String,
    entry: String,
    dependencies: Vec<Dependency>,
    modules: Vec<ModuleAlias>,
}

// 把 `dependencies.<名字>` 这类键的前缀切出来。
fn dependency_prefix(): String {
    return "dependencies.";
}

// 读一个目录下的清单。目录里没有 package.toml 时返回 Err。
pub fn load_manifest(root: String): Result<Manifest, String> {
    let path: String = join_path(root, "package.toml");
    let loaded: Result<String, String> = fs.read_text(path);
    if (is_err(loaded)) {
        return Result<Manifest, String>.Err("no package.toml in this directory");
    }
    let text: String = unwrap_or(loaded, "");

    let parsed: Result<Toml, String> = toml.parse(text);
    if (is_err(parsed)) {
        return Result<Manifest, String>.Err("cannot parse package.toml");
    }
    let document: Toml = unwrap_or(parsed, toml.empty());

    let name: String = toml.get(document, "package.name");
    let version: String = toml.get(document, "package.version");
    let entry: String = toml.get(document, "package.entry");
    if (name.len() == 0) {
        toml.free(document);
        return Result<Manifest, String>.Err("package.toml has no [package] name");
    }
    if (entry.len() == 0) {
        toml.free(document);
        return Result<Manifest, String>.Err("package.toml has no [package] entry");
    }

    // 依赖名 = `dependencies.` 后面、下一个点之前的那一段。
    let prefix: String = dependency_prefix();
    let all_keys: Vec<String> = toml.keys_with_prefix(document, prefix);
    let names: Vec<String> = vec.new();
    let paths: Vec<String> = vec.new();
    let git_urls: Vec<String> = vec.new();
    let revisions: Vec<String> = vec.new();
    let index: uint = 0;
    while (index < all_keys.len()) {
        let key: String = all_keys.get(index);
        let rest: String = key.slice(prefix.len(), key.len());
        // 依赖名来自 `dependencies.<名>`，内联表可继续带 path / git / rev 子键。
        let dot: i64 = find_byte(rest, 46); // '.'
        let dependency_name: String = "";
        if (dot < 0) {
            dependency_name = rest;
        } else {
            dependency_name = rest.slice(0, dot);
        }
        if (dependency_name.len() > 0 && !contains(names, dependency_name)) {
            names.push(dependency_name);
            paths.push(
                toml.get(document, join_key(prefix, dependency_name, ".path")));
            git_urls.push(
                toml.get(document, join_key(prefix, dependency_name, ".git")));
            revisions.push(
                toml.get(document, join_key(prefix, dependency_name, ".rev")));
        }
        index = index + 1;
    }
    vec.free(all_keys);

    // 模块别名：`[modules] name = "path"`，在 TOML 里键是 `modules.<name>`。
    // 路径原样保留，由调用方决定相对包根还是绝对路径。
    let module_prefix: String = "modules.";
    let module_keys: Vec<String> = toml.keys_with_prefix(document, module_prefix);
    let module_names: Vec<String> = vec.new();
    let module_paths: Vec<String> = vec.new();
    let module_index: uint = 0;
    while (module_index < module_keys.len()) {
        let key: String = module_keys.get(module_index);
        let module_name: String = key.slice(module_prefix.len(), key.len());
        if (module_name.len() > 0) {
            module_names.push(module_name);
            module_paths.push(toml.get(document, key));
        }
        module_index = module_index + 1;
    }
    vec.free(module_keys);

    toml.free(document);

    let dependencies: Vec<Dependency> = vec.new();
    let item: uint = 0;
    while (item < names.len()) {
        dependencies.push(Dependency {
            name: names.get(item),
            path: paths.get(item),
            git: git_urls.get(item),
            rev: revisions.get(item),
        });
        item = item + 1;
    }
    vec.free(names);
    vec.free(paths);
    vec.free(git_urls);
    vec.free(revisions);

    let modules: Vec<ModuleAlias> = vec.new();
    let module_item: uint = 0;
    while (module_item < module_names.len()) {
        modules.push(ModuleAlias {
            name: module_names.get(module_item),
            path: module_paths.get(module_item),
        });
        module_item = module_item + 1;
    }
    vec.free(module_names);
    vec.free(module_paths);

    return Result<Manifest, String>.Ok(Manifest {
        root: root,
        name: name,
        version: version,
        entry: entry,
        dependencies: dependencies,
        modules: modules,
    });
}

// 空清单，给「加载失败时想返回占位值」的调用方用。
pub fn blank_manifest(): Manifest {
    return Manifest {
        root: "",
        name: "",
        version: "",
        entry: "",
        dependencies: vec.new(),
        modules: vec.new(),
    };
}

// 拼三段键：prefix + name + suffix。
fn join_key(prefix: String, name: String, suffix: String): String {
    let builder: StringBuilder = sb.new();
    builder.append(prefix);
    builder.append(name);
    builder.append(suffix);
    let text: String = builder.to_string();
    builder.free();
    return text;
}

// 在 text 里找第一个 byte；找不到返回 -1。
pub fn find_byte(text: String, byte: u8): i64 {
    let index: uint = 0;
    while (index < text.len()) {
        if (text.byte_at(index) == byte) {
            let position: i64 = index; // uint -> i64 是隐式转换
            return position;
        }
        index = index + 1;
    }
    return -1;
}

// 字符串数组里有没有这个值。
pub fn contains(values: Vec<String>, value: String): bool {
    let index: uint = 0;
    while (index < values.len()) {
        if (values.get(index) == value) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

pub fn free_manifest(manifest: Manifest): i32 {
    vec.free(manifest.dependencies);
    return vec.free(manifest.modules);
}

// 把一个包写进锁文件用的文本片段。
pub fn lock_entry(name: String, version: String, source: String): String {
    let builder: StringBuilder = sb.new();
    builder.append("[[package]]\nname = \"");
    builder.append(name);
    builder.append("\"\nversion = \"");
    builder.append(version);
    builder.append("\"\nsource = \"");
    builder.append(source);
    builder.append("\"\n\n");
    let text: String = builder.to_string();
    builder.free();
    return text;
}
