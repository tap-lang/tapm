// `tapm test`：跑 tests/ 下的用例。
//
// 用例本身也是 **tap 文件**（每个有自己的 main，返回 0 表示通过），
// 断言库在 tests/lib.tp。这里只负责编排：发现、隔离、执行、统计、报告。
//
// 每个用例用 `tap run` 起一个独立进程跑 —— 既隔离了 new 生成的目录，
// 也保证用例里的相对路径不会碰到仓库里的东西。子进程输出用 process 库直接拿。

import std.fs as fs;
import std.sys as sys;
import std.env as env;
import std.vec as vec;
import std.vec.Vec;
import process.command as proc;
import process.command.Command;
import process.command.Output;

// 从环境变量取值，空则用默认。
fn setting(name: String, fallback: String): String {
    let value: String = env.var(name);
    if (value.len() == 0) {
        return fallback;
    }
    return value;
}

// 递归删除目录：fs.remove_entry 只能删空目录（和 C 的 rmdir/RemoveDirectory 一致），
// 所以要自己先清空。以前这里是一句 `sys.system("rm -rf ...")`，但 Windows 上没有
// rm，而且拼 shell 命令还得处理引号和空格，直接走 fs 更省事。
fn remove_tree(path: String): i32 {
    if (!fs.is_dir(path)) {
        fs.make_writable(path);
        return fs.remove_entry(path);
    }
    let listing: Result<Vec<String>, String> = fs.read_dir(path);
    if (listing.is_ok()) {
        let entries: Vec<String> = match (listing) {
            Result.Ok(value) => value,
            Result.Err(reason) => vec.new<String>(),
        };
        for (let i: i64 = 0; i < entries.len() as i64; i = i + 1) {
            remove_tree(path + "/" + entries.get(i as uint));
        }
        vec.free(entries);
    }
    // Git for Windows 把 .git/objects 里的文件设成只读，属性没清掉就删不动。
    fs.make_writable(path);
    return fs.remove_entry(path);
}

// 是不是绝对路径。POSIX 看前缀 `/`；Windows 还要认盘符（`C:/x`、`C:\x`）。
fn is_absolute(path: String): bool {
    if (path.starts_with("/")) {
        return true;
    }
    if (path.len() >= 3 && path.byte_at(1) == 58) {
        return true;
    }
    return false;
}

// 放临时工作目录的地方。POSIX 用 /tmp，Windows 用 TEMP（通常是
// C:\Users\<用户>\AppData\Local\Temp）—— 直接写 /tmp 在 Windows 上会被解释成
// 当前盘的根目录，普通用户没权限建。
fn scratch_dir(): String {
    if (sys.is_windows()) {
        let temp: String = env.var("TEMP");
        if (temp.len() == 0) {
            temp = env.var("TMP");
        }
        if (temp.len() > 0) {
            return temp + "/tapm-test";
        }
    }
    return "/tmp/tapm-test";
}

// TAP_MODULE_PATH 是**一个字符串**里的多个根：POSIX 用冒号，Windows 用分号
// （和 PATH 一样，因为冒号在 Windows 路径里是盘符分隔符）。
fn module_separator(): String {
    if (sys.is_windows()) {
        return ";";
    }
    return ":";
}

// 收集 tests/ 下的 .tp 文件名。lib.tp 是断言库，不是独立用例。
// 读不到目录就返回空表，由调用方报错。
fn collect_cases(base: String): Vec<String> {
    let listing: Result<Vec<String>, String> = fs.read_dir(base + "/tests");
    if (!listing.is_ok()) {
        return vec.new<String>();
    }
    let entries: Vec<String> = match (listing) {
        Result.Ok(value) => value,
        Result.Err(reason) => vec.new<String>(),
    };

    let cases: Vec<String> = vec.new<String>();
    for (let i: i64 = 0; i < entries.len() as i64; i = i + 1) {
        let entry: String = entries.get(i as uint);
        if (entry.ends_with(".tp") && entry != "lib.tp") {
            cases.push(entry);
        }
    }
    return cases;
}

// 跑单个用例，返回它的输出和退出码。
fn run_case(file: String, tap_path: String, tapm_path: String,
            tests_root: String, module_path: String,
            work_dir: String, std_path: String): Result<Output, String> {
    let name: String = file.slice(0, file.len() - 3);
    let work: String = work_dir + "/" + name;
    fs.make_dir(work);

    let command: Command = proc.new(tap_path);
    command = proc.arg(command, "run");
    command = proc.arg(command, tests_root + "/" + file);
    command = proc.current_dir(command, work);
    // tests/ 让用例能 import lib，src/ 让用例能直接导入被测包模块。
    // 用例要跑 tapm，靠 TAPM 拿路径。
    command = proc.env(command, "TAPM", tapm_path);
    command = proc.env(command, "TAP_MODULE_PATH", module_path);
    if (std_path.len() > 0) {
        command = proc.env(command, "TAP_STD_PATH", std_path);
    }
    return proc.output(command);
}

pub fn run(root: String): i32 {
    // 用例在 <root>/tests/.work/<name>/ 里跑，所以路径必须是绝对的。
    // 产物名跟平台走：`tap build` 在 Windows 上给的是 build/tapm.exe。
    let executable_suffix: String = "";
    if (sys.is_windows()) {
        executable_suffix = ".exe";
    }
    let tapm_path: String = setting(
        "TAPM", root + "/build/tapm" + executable_suffix);
    if (!is_absolute(tapm_path)) {
        tapm_path = root + "/" + tapm_path;
    }
    let tap_path: String = setting("TAP", "tap");
    let std_path: String = env.var("TAP_STD_PATH");
    let tests_root: String = root + "/tests";
    // 编译器支持用平台分隔符列出多个 TAP_MODULE_PATH 根。测试辅助模块放在 tests/，
    // 被测包模块放在 src/；调用者额外提供的模块根继续保留在末尾。
    let separator: String = module_separator();
    let module_path: String = tests_root + separator + root + "/src";
    let inherited_module_path: String = env.var("TAP_MODULE_PATH");
    if (inherited_module_path.len() > 0) {
        module_path = module_path + separator + inherited_module_path;
    }
    // 工作目录放在**包外**：用例要测「空目录下的行为」（比如 list 找不到 packages/），
    // 如果放在 <root>/tests/.work/ 里，tapm 的向上查找会找到 tapm 自己的包根，
    // 用例就测不出东西了。
    let work_dir: String = scratch_dir();

    let cases: Vec<String> = collect_cases(root);
    if (cases.len() == 0) {
        // 包根是靠向上找 package.toml 定的，所以走到这里说明包根有 manifest
        // 但 tests/ 下没有用例 —— 把找的是哪个目录打出来，方便排查。
        print("tapm test: %s/tests 里没有用例\n", root);
        return 2;
    }

    remove_tree(work_dir);
    fs.make_dir(work_dir);

    let passed: i32 = 0;
    let failed: i32 = 0;
    let failed_names: Vec<String> = vec.new<String>();
    let filter: String = env.var("TEST_FILTER");

    for (let i: i64 = 0; i < cases.len() as i64; i = i + 1) {
        let file: String = cases.get(i as uint);
        let name: String = file.slice(0, file.len() - 3);
        let case_path: String = "tests/" + file;

        if (filter.len() > 0 && !name.contains(filter)) {
            continue;
        }

        let result: Result<Output, String> =
            run_case(file, tap_path, tapm_path, tests_root, module_path,
                     work_dir, std_path);
        match (result) {
            Result.Ok(value) => {
                if (value.status == 0) {
                    print("PASS %s\n", case_path);
                    passed = passed + 1;
                } else {
                    print("FAIL %s\n", case_path);
                    // 用例的断言信息走 stdout（lib.tp 用 print），
                    // 编译错误走 stderr，两路都摊开。
                    print("%s", value.stdout);
                    print("%s", value.stderr);
                    failed = failed + 1;
                    failed_names.push(case_path);
                }
            }
            Result.Err(reason) => {
                print("FAIL %s\n", case_path);
                print("  启动失败: %s\n", reason);
                failed = failed + 1;
                failed_names.push(case_path);
            }
        }
    }

    remove_tree(work_dir);

    print("\n%d passed, %d failed\n", passed, failed);
    if (failed > 0) {
        print("失败的用例:");
        for (let i: i64 = 0; i < failed_names.len() as i64; i = i + 1) {
            print(" %s", failed_names.get(i as uint));
        }
        print("\n");
        return 1;
    }
    return 0;
}
